APP_NAME=JiwaSehat
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=jiwasehat
DB_USERNAME=root
DB_PASSWORD=

# Sesi/cache lokal awal tidak membutuhkan migration database.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
CACHE_STORE=file
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=180
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@example.test"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
ENABLE_LEGACY_PREVIEW=false
INERTIA_ENCRYPT_HISTORY=true

# Provider; isi kredensial privat pada .env, bukan source code.
WHATSAPP_DRIVER=placeholder
WHATSAPP_SENDER_PHONE=
WHATSAPP_BRIDGE_URL=http://127.0.0.1:3210
WHATSAPP_BRIDGE_SECRET=

# Hanya preview lokal; bukan TTL reservasi backend.
VITE_MOCK_HOLD_MINUTES=15

GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
