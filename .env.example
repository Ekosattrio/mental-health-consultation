# URL API Laravel 12+. Jangan tambahkan slash di akhir.
VITE_API_BASE_URL="http://localhost:8000/api/v1"

# Timeout request frontend ke backend dalam milidetik.
VITE_API_TIMEOUT_MS="15000"

# Aktifkan jika Laravel Sanctum memakai autentikasi SPA berbasis cookie.
VITE_SANCTUM_CSRF="true"

# Hanya prototype browser; TTL produksi wajib ditentukan server.
VITE_MOCK_HOLD_MINUTES="15"
